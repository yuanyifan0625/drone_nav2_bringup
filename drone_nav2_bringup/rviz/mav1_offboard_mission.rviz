Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.7
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Enabled: true
      Name: Static Occupancy Map
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map
      Value: true
    - Class: rviz_default_plugins/Path
      Color: 255; 215; 0
      Enabled: true
      Line Style: Lines
      Line Width: 0.08
      Name: MAV1 Global Plan
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /MAV1/plan
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Arena Walls
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /arena_walls
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Route Graph
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /route_graph
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: MAV1 Coordinate Cross-Check
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /vehicle_marker
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 1
      Name: MAV1 TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Value: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /MAV1/formation_goal_pose
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Scale: 45
      Target Frame: <Fixed Frame>
